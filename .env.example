# Solana RPC. The public devnet endpoint rate-limits hard and adds roughly a
# second to every verification; use a dedicated provider (Helius, Triton,
# QuickNode) for anything user-facing.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_CLUSTER=devnet
