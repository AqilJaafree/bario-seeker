# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local session state
.agents
.claude

# Solana / Anchor build output and keypairs.
# Belt-and-braces: bario-seeker-program/.gitignore already covers these, but a
# leaked keypair cannot be un-leaked, so the rules are repeated at the root.
**/target/
**/.anchor/
**/test-ledger/
.demo-keys.json
**/scripts/.demo-keys.json
*-keypair.json
*.so
id.json
